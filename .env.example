# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cardsdb
# true for hosted Postgres that requires TLS (Neon, Supabase...)
DB_SSL=false
JWT_SECRET=supersecret
FRONTEND_ORIGIN=http://localhost:5173
# SMTP for sign-up confirmation and login codes (any provider: Gmail, Resend, SendGrid, SES...).
# Optional outside production: without SMTP_HOST the e-mail is written to the log.
# docker compose sets SMTP_HOST=mailpit / SMTP_PORT=1025 for the bundled Mailpit (UI: http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Financial App <no-reply@example.com>
# production disables Swagger and the dev seed
NODE_ENV=development
