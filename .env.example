# Backend
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cardsdb
# true for hosted Postgres that requires TLS (Neon, Supabase...)
DB_SSL=false
JWT_SECRET=supersecret
FRONTEND_ORIGIN=http://localhost:5173
# Number of proxies in front of the app (hosting); 0 = none. Rate limiting uses the client IP behind them.
TRUST_PROXY=0
# E-mail for sign-up confirmation and login codes: the Resend API (RESEND_API_KEY, wins when set;
# use it on hosts that block SMTP, like Render's free plan) or any SMTP server (SMTP_*).
# Optional outside production: without either the e-mail is written to the log.
RESEND_API_KEY=
# Sender; with Resend it must use a domain verified there
MAIL_FROM=Financial App <no-reply@example.com>
# docker compose sets SMTP_HOST=mailpit / SMTP_PORT=1025 for the bundled Mailpit (UI: http://localhost:8025).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# production disables Swagger and the dev seed
NODE_ENV=development
